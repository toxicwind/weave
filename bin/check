#!/usr/bin/env bash
# weave (barn shell) — entity-level semantic merge for Git. bin/check.
#
# Fast self-test (PASS/FAIL), no compile:
#   1. Cargo workspace parses.
#   2. CLI + MCP entry points present (bin/weave.js, bin/weave-mcp.js).
#   3. crates/ source present.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== weave check: start =="
cmd="$(command -v cargo 2>/dev/null || true)"
CARGO=""
for c in /home/toxic/.cargo/bin/cargo "$cmd" /usr/local/bin/cargo /usr/bin/cargo; do
  [ -n "$c" ] && [ -x "$c" ] && { CARGO="$c"; break; }
done
[ -n "${CARGO:-}" ] || { echo "FAIL: cargo not found"; exit 1; }

"$CARGO" metadata --no-deps --format-version 1 >/dev/null 2>&1 \
  || { echo "FAIL: Cargo workspace does not parse"; exit 1; }
echo "OK: Cargo workspace parses"

for f in bin/weave.js bin/weave-mcp.js bin/weave-driver.js; do
  if [ -f "$f" ]; then echo "OK: $f present"; else echo "FAIL: $f missing"; exit 1; fi
done
[ -d crates ] && echo "OK: crates/ present" || echo "WARN: crates/ missing"
echo "WEAVE CHECK: PASS"
exit 0